{
    "name": "nails/module-calendar",
    "keywords":
    [
        "Nails",
        "Shed Collective",
        "CodeIgniter",
        "Calendar Module"
    ],
    "homepage": "http://nailsapp.co.uk/modules/calendar",
    "description": "This is the calendar module for Nails. It provides basic calendar functionality.",
    "license": "MIT",
    "authors":
    [
        {
            "name": "Pablo de la Pena",
            "email": "p@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        }
    ],
    "support":
    {
        "email": "hello@nailsapp.co.uk"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "nails/common": "dev-develop"
    },
    "require-dev":
    {
        "phpunit/phpunit": "11.*",
        "phpstan/phpstan": "2.*"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\Calendar\\": "src/"
        }
    },
    "extra":
    {
        "nails":
        {
            "moduleName": "calendar",
            "type": "module",
            "namespace": "Nails\\Calendar\\"
        }
    }
}